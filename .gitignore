### macOS
# Finder metadata
.DS_Store

# Custom folder icons
Icon

# Volume root files
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### Unity
# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Build output
*.apk
*.aab
*.unitypackage

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.suo

### JetBrains
# JetBrains IDE directory
.idea/

# CMake build directories
cmake-build-*/

# File-based project format
*.iws
*.iml

# IntelliJ build output
out/

### C#
# Build results
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# User-specific files
*.suo
*.user

# Debug symbols
*.pdb

# NuGet Packages
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# .NET build artifacts
artifacts/

# Publish output
publish/

### memsearch
# Runtime artifacts — memory markdown stays tracked
.memsearch/.capture.pid
.memsearch/.index.pid
.memsearch/.last_msg_time
# Project config holds the collection name, which is derived from this machine's
# absolute path (ms_<basename>_<sha8>). bootstrap.sh regenerates it on clone.
.memsearch.toml

### Java
# Compiled class file
*.class

# Log file
*.log

# Package Files
*.jar
*.war
*.ear

# Virtual machine crash logs
hs_err_pid*
replay_pid*
# Machine-specific bootstrap state
.install-state.json
# Hook logs, such as the autoharness create-bar verdict log
/.state/

# python bytecode from running the vendored eval harness
scripts/evals/**/__pycache__/

# python bytecode from running vendored skill scripts (skill-creator/scripts/*)
skills/**/__pycache__/

# response-quality eval outputs (model response bodies + hand-authored scores; cost real money to
# regenerate but are run-specific — the corpus and rubric are versioned, the results are not)
scripts/evals/response-quality/results/

# python bytecode anywhere (supersedes the per-path rules above)
__pycache__/

# Per-tool config files, never tracked (§workspace)
/.claude/
/.codebuddy/
/.cursor/
/.gemini/
/.kiro/
/.qoder/
/.github/instructions/
/.cursorrules
/.windsurfrules
/CODEBUDDY.md
/GEMINI.md
/QODER.md
/.mcp.json

# Claude Code writes marketplace/built-in skill payloads here, because ~/.claude/skills
# symlinks into this repo. Machine-local, regenerates on sync, not Jacob content.
skills/synced/

# autoharness plugin (global layer = ~/.claude/skills = this folder). Its skills themselves are
# tracked; retired ones and its per-skill file locks are not. See scripts/sync-autoharness-lock.sh.
skills/.archive/
skills/**/*.json.lock

# autoharness writes per-session state into .claude/autoharness/ under whatever folder a session starts in.
**/.claude/autoharness/

# graphify cache, regenerable on demand
graphify-out/
